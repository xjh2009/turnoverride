{
  "schemaVersion": 1,
  "id": "turnoverride",
  "version": "${version}",
  "name": "TURN Override",
  "description": "Override the TURN/ICE servers used by Minecraft's WebRTC P2P (Friend Worlds). Supports static config and remote URL fetching.",
  "authors": [
    "you"
  ],
  "contact": {},
  "license": "APL2",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.xjhya.turnoverride.TurnOverrideMod"
    ]
  },
  "mixins": [
    "turnoverride.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": ">=1.21",
    "java": ">=21"
  }
}
